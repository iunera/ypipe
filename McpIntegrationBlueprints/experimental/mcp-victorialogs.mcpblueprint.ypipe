apiVersion: "mcp.ypipe.com/v1"
kind: "McpIntegrationBlueprint"
metadata:
  name: "mcp-victorialogs"
  namespace: "system"
spec:
  displayName: VictoriaLogs MCP Server
  description: |
    This provides access to your VictoriaLogs instance and seamless integration with VictoriaLogs APIs and documentation. It can give you a comprehensive interface for logs, observability, and debugging tasks related to your VictoriaLogs instances, enable advanced automation and interaction capabilities for engineers and tools.
  source: "https://github.com/VictoriaMetrics/mcp-victorialogs"
  configurationSchema:
    VL_INSTANCE_ENTRYPOINT:
      type: "string"
      required: true
      default: "https://play-vmlogs.victoriametrics.com"
      description: "The HTTP URL of the VictoriaLogs instance"
      sensitive: false
      pattern: null
    VL_INSTANCE_BEARER_TOKEN:
      type: "string"
      required: false
      default: ""
      description: "Optional Bearer token for authentication"
      sensitive: true
      pattern: null
    VL_DEFAULT_TENANT_ID:
      type: "string"
      required: false
      default: "0:0"
      description: "Default tenant ID for VictoriaLogs (account:project)"
      sensitive: false
      pattern: null
    MCP_LOG_LEVEL:
      type: "string"
      required: false
      default: "warn"
      description: "Log level for the MCP server"
      sensitive: false
      pattern: null
  mcpConfig:
    type: "stdio"
    command: "mcp-victorialogs"
    args: []
    env:
      VL_INSTANCE_ENTRYPOINT: "${VL_INSTANCE_ENTRYPOINT}"
      VL_INSTANCE_BEARER_TOKEN: "${VL_INSTANCE_BEARER_TOKEN}"
      VL_DEFAULT_TENANT_ID: "${VL_DEFAULT_TENANT_ID}"
      MCP_LOG_LEVEL: "${MCP_LOG_LEVEL}"
    binaryDownloads:
      darwin_arm64: "https://github.com/VictoriaMetrics/mcp-victorialogs/releases/download/v1.9.0/mcp-victorialogs_Darwin_arm64.tar.gz"
      darwin_x86_64: "https://github.com/VictoriaMetrics/mcp-victorialogs/releases/download/v1.9.0/mcp-victorialogs_Darwin_x86_64.tar.gz"
      linux_arm64: "https://github.com/VictoriaMetrics/mcp-victorialogs/releases/download/v1.9.0/mcp-victorialogs_Linux_arm64.tar.gz"
      linux_x86_64: "https://github.com/VictoriaMetrics/mcp-victorialogs/releases/download/v1.9.0/mcp-victorialogs_Linux_x86_64.tar.gz"
      windows_x86_64: "https://github.com/VictoriaMetrics/mcp-victorialogs/releases/download/v1.9.0/mcp-victorialogs_Windows_x86_64.zip"
      windows_arm64: "https://github.com/VictoriaMetrics/mcp-victorialogs/releases/download/v1.9.0/mcp-victorialogs_Windows_arm64.zip"
