apiVersion: "mcp.ypipe.com/v1"
kind: "McpIntegrationBlueprint"
metadata:
  name: "neo4j"
  namespace: "system"
spec:
  displayName: Neo4j
  description: |
    This provides access to your Neo4j graph database instance, allowing seamless integration with Neo4j Cypher queries and database schemas. It enables tools and assistants to query the graph data model, introspect node labels, relationship types, and property keys, run Cypher read/write queries, and discover Graph Data Science (GDS) procedures.
  source: "https://github.com/neo4j/mcp"
  configurationSchema:
    NEO4J_URI:
      type: "string"
      required: true
      default: "bolt://localhost:7687"
      description: "The connection URI for the Neo4j database (e.g., bolt://localhost:7687 or neo4j+s://<host>)"
      sensitive: false
      pattern: null
    NEO4J_USERNAME:
      type: "string"
      required: true
      default: "neo4j"
      description: "Database authentication username"
      sensitive: false
      pattern: null
    NEO4J_PASSWORD:
      type: "string"
      required: true
      default: ""
      description: "Database authentication password"
      sensitive: true
      pattern: null
    NEO4J_DATABASE:
      type: "string"
      required: false
      default: "neo4j"
      description: "The target database name to use"
      sensitive: false
      pattern: null
    NEO4J_READ_ONLY:
      type: "boolean"
      required: false
      default: "false"
      description: "If set to true, disables write Cypher queries"
      sensitive: false
      pattern: null
  mcpConfig:
    type: "stdio"
    command: "neo4j-mcp"
    args:
      - --neo4j-transport-mode
      - stdio
      - --neo4j-telemetry
      - false
    env:
      NEO4J_URI: "${NEO4J_URI}"
      NEO4J_USERNAME: "${NEO4J_USERNAME}"
      NEO4J_PASSWORD: "${NEO4J_PASSWORD}"
      NEO4J_DATABASE: "${NEO4J_DATABASE}"
      NEO4J_READ_ONLY: "${NEO4J_READ_ONLY}"
    binaryDownloads:
      darwin_arm64: "https://github.com/neo4j/mcp/releases/download/v1.5.3/neo4j-mcp_Darwin_arm64.tar.gz"
      darwin_x86_64: "https://github.com/neo4j/mcp/releases/download/v1.5.3/neo4j-mcp_Darwin_x86_64.tar.gz"
      linux_arm64: "https://github.com/neo4j/mcp/releases/download/v1.5.3/neo4j-mcp_Linux_arm64.tar.gz"
      linux_x86_64: "https://github.com/neo4j/mcp/releases/download/v1.5.3/neo4j-mcp_Linux_x86_64.tar.gz"
      windows_x86_64: "https://github.com/neo4j/mcp/releases/download/v1.5.3/neo4j-mcp_Windows_x86_64.zip"
      windows_arm64: "https://github.com/neo4j/mcp/releases/download/v1.5.3/neo4j-mcp_Windows_arm64.zip"
  suggestions:
    - id: "neo4j-get-schema"
      title: "Neo4j: Get Schema"
      label: "Retrieve Neo4j graph database schema"
      action: "Inspect my Neo4j database schema and tell me what node labels and relationship types exist."
      actionType: null
      target: null
    - id: "neo4j-read-cypher"
      title: "Neo4j: Find Nodes"
      label: "Query nodes using Cypher"
      action: "Run a Cypher query to find 10 nodes of the most common label and show their properties."
      actionType: null
      target: null
    - id: "neo4j-list-gds"
      title: "Neo4j: List GDS Algorithms"
      label: "List Graph Data Science procedures"
      action: "Show me all available Graph Data Science (GDS) procedures in my database."
      actionType: null
      target: null
  disabledTools:
    - "write-cypher"
  tools:
    get-schema:
      description: "Retrieve schema information including labels, relationship types, and properties from the Neo4j database."
      usageIntent: "Introspect and map the graph database schema structure to construct valid Cypher queries."
      discoveryHint: |
        Systematically retrieve and introspect the internal graph database schema structure of the Neo4j instance.
        This tool provides a comprehensive mapping of all active node labels, relationship types (edges), and property keys, including their associated data types.
        It is a crucial reconnaissance utility that allows the AI to discover the topology and structural model of a graph database without any prior knowledge.
        Before formulating or executing any Cypher query, the agent should call this tool to inspect the active nodes, labels, and connections.
        By identifying the exact shape and naming conventions of the graph schema, the agent prevents syntax errors and ensures queries are highly targeted and optimized.
        Synonyms include graph schema inspection, database introspection, label listing, relationship mapping, node property discovery, and structural reconnaissance.
        Common use cases include mapping social networks, dependency graphs, identity patterns, and knowledge graphs to understand their structural elements before running queries.
        Keywords: Neo4j schema, graph topology, node labels, relationship types, property keys, metadata discovery, database introspection, graph schema reconnaissance, data modeling, Cypher builder.
      properties: null
      required: null
    read-cypher:
      description: "Execute a read-only Cypher query against the Neo4j database."
      usageIntent: "Query database data (nodes, relationships, attributes, paths) without mutating the graph."
      discoveryHint: |
        Execute high-performance read-only Cypher queries against the Neo4j graph database to search, retrieve, and traverse nodes, relationships, attributes, and paths.
        Cypher is Neo4j's expressive graph query language designed for pattern matching and path traversal.
        This tool strictly prevents mutating actions (like CREATE, MERGE, SET, DELETE, REMOVE) via built-in safety controls, making it secure for analytical reads.
        It is the primary read interface for database interaction, allowing the agent to retrieve nodes, filter them by attributes, compute aggregations, trace paths, and extract structural relationships.
        Use this tool when you need to answer natural language questions about the data, extract graph metrics, find specific entities, or trace connections.
        By leveraging Cypher's MATCH clause, the agent can traverse complex relationship chains (e.g., friend-of-a-friend or dependency hierarchies) in a single operation.
        Synonyms include executing Cypher reads, running graph queries, pattern matching, path retrieval, node fetching, and graph analytics.
        Common use cases include searching for specific user profiles, listing connections, tracing dependencies, retrieving path sequences, and generating analytical reports from graph data.
        Keywords: Neo4j query, Cypher read, pattern matching, path traversal, graph database, MATCH clause, read-only query, data analysis, relationship tracing, graph retrieval.
      properties:
        query:
          type: "string"
          description: "The read-only Cypher query statement"
        params:
          type: "object"
          description: "Key-value parameters map for the Cypher query"
      required:
        - "query"
    write-cypher:
      description: "Execute a Cypher query that modifies the database."
      usageIntent: "Create, update, merge, or delete nodes, relationships, and properties."
      discoveryHint: |
        Execute write Cypher queries against the Neo4j graph database to mutate, create, update, or delete nodes, relationships, and property attributes.
        This tool enables full database state modification and data lifecycle management.
        Use this tool to build nodes (CREATE), insert relationships between existing nodes (MERGE), update properties (SET), remove attributes (REMOVE), or delete graph structures (DELETE).
        It supports transactional write operations, ensuring atomic changes and maintaining graph database integrity.
        This tool is disabled if NEO4J_READ_ONLY is set to true on the server, enforcing a read-only safeguard.
        It is critical for tasks that require mutating the database in response to user actions or inputs, such as registering new nodes, building relationship links, or cleaning up obsolete data.
        Synonyms include graph mutation, writing Cypher, database modification, inserting nodes, creating relationships, and deleting entities.
        Common use cases include building a knowledge base, adding edges between entities, updating node properties, inserting transactional data, and performing data cleanups.
        Keywords: Cypher write, graph mutation, CREATE node, MERGE relationship, database update, SET properties, DELETE node, transactional mutation, data modification, graph update.
      properties:
        query:
          type: "string"
          description: "The write Cypher query statement"
        params:
          type: "object"
          description: "Key-value parameters map for the Cypher query"
      required:
        - "query"
    list-gds-procedures:
      description: "List all available Graph Data Science (GDS) procedures."
      usageIntent: "Explore and discover what GDS algorithms (e.g., PageRank, Louvain, Weakly Connected Components) are available in the instance."
      discoveryHint: |
        Discover, audit, and list the available Graph Data Science (GDS) procedures and algorithms installed in the current Neo4j environment.
        This tool returns a detailed index of graph science functions, describing what each algorithm does, its input arguments, signature, and output structures.
        The Neo4j GDS library provides powerful, optimized graph algorithms for analytical operations like centrality, community detection, similarity scoring, pathfinding, and link prediction.
        The agent should call this tool to see what analytical tools are supported by the server before attempting to invoke GDS algorithms.
        This enables the agent to select the correct algorithm (e.g., PageRank, Louvain, Betweenness Centrality, Cosine Similarity) and understand its exact syntax and parameters.
        Synonyms include GDS discovery, listing graph algorithms, centralities check, community detection mapping, similarity procedure lookup, and analytic capabilities audit.
        Common use cases include auditing environment capabilities, checking PageRank availability, identifying pathfinding procedures, and finding the correct syntax for community detection algorithms.
        Keywords: Neo4j GDS, Graph Data Science, graph algorithms, centrality, community detection, pathfinding, similarity scoring, procedure discovery, link prediction, graph analytics.
      properties: null
      required: null
