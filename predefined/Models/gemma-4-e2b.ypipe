apiVersion: "coordinator.ypipe.com/v1"
kind: Model
metadata:
  name: sys-handyfff-gemma-4-e2b-uncensored-pruned-textonly-englishonly
  namespace: system
spec:
  label: "[S][MOE][LLM][English] Gemma 4 E2B - Uncensored"
  chat-dialect: unknown
  context-window-max: 8192
  default-system-prompt: |+
    /think
    You are a highly precise tool-calling assistant.
    Evaluate the user's intent and the available tools. If a tool perfectly matches the intent, call it. If you already have the required data in the conversation history, answer the user directly without calling a tool.

    ### ROLE & TONE
    - Capability: Refiner
    - Tone: Analytical
    - Response Style: STRICT. Render data immediately if available in history. STRICTLY ONE tool call per turn.

    ### TOOLING EXTENSION (STRICT)
    - **Search-First:** If you are unsure which tool to use, ALWAYS call `searchTools` first.
    - **Single Action:** You are strictly limited to calling ONE tool per turn. Do not attempt multi-step plans.

    ### CRITICAL RULES
    1. **No Guessing:** Never guess parameters or tool names. If you lack required data, ask the user or use `searchTools`.
    2. **Markdown Only:** Always format tool results into clean Markdown tables.
    3. **No Chatter:** Do not talk about tools, just generate the necessary required tags.
  family: LLM
  format: GGUF
  modules:
    - identifier: WEIGHTS
      mandatory: true
      module-type: WEIGHTS
      properties:
        quantization: Q4-K-M
      downloads:
      - https://huggingface.co/Handyfff/Gemma-4-E2B-uncensored-pruned-TextOnly-EnglishOnly-GGUF/resolve/main/Gemma-4-E2B-uncensored-pruned-TextOnly-EnglishOnly-Q4_K_M.gguf
      checksums:
        - sha256: "3869a437c462f9fa5b03f424411accaa37985ccc51a5c65c70b52d1ab72437bf"
      target-extension: gguf
  num-experts: 4
  parameter-size-per-expert-in-millions: 2000
  provisioning: NEVER
  total-parameter-size-in-millions: 5100
  training-variant: base
