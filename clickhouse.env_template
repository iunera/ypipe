# CLICKHOUSE_HOST
# The hostname of your ClickHouse server. (e.g. local docker hosted clickhouse with "host.docker.internal")
# Default: host.docker.internal
CLICKHOUSE_HOST=

# CLICKHOUSE_PORT
# The port of your ClickHouse server.
# Default: 8123
CLICKHOUSE_PORT=

# CLICKHOUSE_SECURE
# Set to true/false for secure connection (SSL/TLS) to clickhosue.
# Default: false
CLICKHOUSE_SECURE=

# CLICKHOUSE_VERIFY
# Set to true to verify the SSL certificate.
# Default: false
CLICKHOUSE_VERIFY=

# CLICKHOUSE_USER
# The username for authenticating with ClickHouse. e.g. "default"
# Default: default
CLICKHOUSE_USER=

# CLICKHOUSE_PASSWORD
# The password for authenticating with ClickHouse. e.g. "clickhouse" default password
# Default: clickhouse
CLICKHOUSE_PASSWORD=

# CLICKHOUSE_DATABASE
# The ClickHouse database to connect to. e.g. "default"
# Default: default
CLICKHOUSE_DATABASE=

# CLICKHOUSE_MCP_SERVER_TRANSPORT
# The transport mode for the MCP server (e.g., http).
CLICKHOUSE_MCP_SERVER_TRANSPORT=http

# CLICKHOUSE_MCP_BIND_HOST
# The address the MCP server should bind to.
CLICKHOUSE_MCP_BIND_HOST=0.0.0.0
