# CLICKHOUSE_HOST
# The hostname of your ClickHouse server.
CLICKHOUSE_HOST=host.docker.internal

# CLICKHOUSE_PORT
# The port of your ClickHouse server. Defaults to 8123.
# CLICKHOUSE_PORT=8123

# CLICKHOUSE_MCP_BIND_HOST
# The address the MCP server should bind to.
CLICKHOUSE_MCP_BIND_HOST=0.0.0.0

# CLICKHOUSE_MCP_BIND_PORT
# The port the MCP server should listen on.
CLICKHOUSE_MCP_BIND_PORT=8082

# CLICKHOUSE_SECURE
# Set to true to use a secure connection (SSL/TLS).
CLICKHOUSE_SECURE=false

# CLICKHOUSE_VERIFY
# Set to true to verify the SSL certificate.
CLICKHOUSE_VERIFY=false

# CLICKHOUSE_USER
# The username for authenticating with ClickHouse.
CLICKHOUSE_USER=default

# CLICKHOUSE_PASSWORD
# The password for authenticating with ClickHouse.
CLICKHOUSE_PASSWORD=clickhouse

# CLICKHOUSE_DATABASE
# The ClickHouse database to connect to.
CLICKHOUSE_DATABASE=default

# CLICKHOUSE_MCP_SERVER_TRANSPORT
# The transport mode for the MCP server (e.g., http).
CLICKHOUSE_MCP_SERVER_TRANSPORT=http
