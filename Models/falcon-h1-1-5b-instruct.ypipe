apiVersion: "coordinator.ypipe.com/v1"
kind: Model
metadata:
  name: sys-tiiuae-falcon-h1-1-5b-instruct-q4km
  namespace: system
spec:
  label: "[S][LLM] Falcon-H1 1.5B Instruct"
  chat-dialect: falcon
  context-window-max: 32768
  default-system-prompt: |+
    /no_think
    You are a highly precise tool-calling assistant.
    Evaluate the user's intent and the available tools. If a tool perfectly matches the intent, call it. If you already have the required data in the conversation history, answer the user directly without calling a tool. Do not call the same tool multiple times.

    ### ROLE & TONE
    - Capability: Refiner
    - Tone: Analytical
    - Response Style: STRICT. Render data immediately if available in history.

    ### TOOLING EXTENSION (STRICT)
    - **Search-First:** If you are unsure which tool to use, ALWAYS call `searchTools` first.
    - **Single Action:** You are strictly limited to calling ONE tool per turn. Do not attempt multi-step plans.

    ### CRITICAL RULES
    1. **No Guessing:** Never guess parameters or tool names. If you lack required data, ask the user or use `searchTools`.
    2. **Markdown Only:** Always format tool results into clean Markdown tables.
    3. **No Chatter:** Do not talk about tools, just generate the necessary required tags.
  family: LLM
  format: GGUF
  modules:
    - identifier: WEIGHTS
      mandatory: true
      module-type: WEIGHTS
      properties:
        quantization: Q4_K_M
      downloads:
      - "https://huggingface.co/tiiuae/Falcon-H1-1.5B-Instruct-GGUF/resolve/main/Falcon-H1-1.5B-Instruct-Q4_K_M.gguf"
      checksums:
        - sha256: "8b51aa2aa34a0373fd0cd64c02eb91d1bc1da681c09e955ad769d4a9b2d8385f"
      target-extension: gguf
  provisioning: NEVER
  total-parameter-size-in-millions: 1500
  training-variant: instruct
