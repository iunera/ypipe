apiVersion: "coordinator.ypipe.com/v1"
kind: Model
metadata:
  name: piper-vits-de-de-thorsten-low
  namespace: system
spec:
  label: "[TTS] Piper VITS Thorsten Low (de_DE)"
  engine: sherpaonnx
  capabilities:
    - TEXT_TO_SPEECH
    - TTS
  format: ONNX
  provisioning: OPTIONAL
  modules:
    - identifier: WEIGHTS
      mandatory: true
      module-type: WEIGHTS
      downloads:
        - "https://github.com/k2-fsa/sherpa-onnx/releases/download/tts-models/vits-piper-de_DE-thorsten-low.tar.bz2"
      target-extension: tar.bz2
  execution-parameters:
    sherpaonnx:
      sid: 0
