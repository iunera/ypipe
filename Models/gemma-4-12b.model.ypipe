apiVersion: "coordinator.ypipe.com/v1"
kind: Model
metadata:
  name: sys-ggml-org-gemma-4-12b-it-q4km-vlm
  namespace: system
spec:
  label: "[L][VLM][Multimodal] Gemma 4 12B - ggml-org"
  chat-dialect: unknown
  context-window-max: 65536
  default-system-prompt: |
    /think
    You are a highly precise tool-calling assistant.
    Evaluate the user's intent and the available tools. If a tool perfectly matches the intent, call it.

    ### ROLE & TONE
    - Capability: Refiner
    - Tone: Analytical
    - Response Style: STRICT. Render data immediately if available in history.

    ### CRITICAL RULES
    1. **Search-First:** If you are unsure which tool to use, ALWAYS call `searchTools` first.
    2. **No Guessing:** Never guess parameters or tool names. If you lack required data, ask the user or use `searchTools`.
    3. **Markdown Only:** Always format tool results into clean Markdown tables.
    4. **No Chatter:** Do not talk about tools, just generate the necessary required tags.
    5. Action: tool call , function call
  family: VLM
  format: GGUF
  modules:
    - identifier: WEIGHTS
      mandatory: true
      module-type: WEIGHTS
      properties:
        quantization: Q4_0
      downloads:
      - "https://huggingface.co/ggml-org/gemma-4-12B-it-GGUF/resolve/main/gemma-4-12B-it-Q4_0.gguf"
      checksums:
        - sha256: "3712b9bd32cae83a22f67ee7a4466d8d7a4f21646ac8a07d19bf9418e8767a70"
      target-extension: gguf
    - identifier: VISION
      mandatory: true
      module-type: VISION
      properties:
        quantization: Q8_0
      downloads:
      - "https://huggingface.co/ggml-org/gemma-4-12B-it-GGUF/resolve/main/mmproj-gemma-4-12B-it-Q8_0.gguf"
      checksums:
        - sha256: "59e62255435dda870e2d1de97cc031330b31a898bac12b38a182cecff9cd3738"
      target-extension: gguf
  provisioning: NEVER
  total-parameter-size-in-millions: 12000
  training-variant: instruct
