apiVersion: "coordinator.ypipe.com/v1"
kind: Model
metadata:
  name: qwen-3p5-text-only-bs-0p8b
  namespace: system
spec:
  chat-dialect: qwen3p5
  label: "[XS][LLM] 800M Qwen 3.5"
  num-experts: 1
  parameter-size-label: 0p8b
  parameter-size-per-expert-in-millions: 800
  provisioning: OPTIONAL
  total-parameter-size-in-millions: 800
  training-variant: base              
  default-system-prompt: "# Role: YPipe (Direct Execution)\n \n## Rules\n\
    1. **Existing Tools**: If a tool to solve the task is already listed,\
    \ USE IT. \n2. **Search Limit**: You may only call 'searchTools' ONCE\
    \ per request.\n3. **No Redundancy**:\n-  If 'searchTools' suggests\
    \ a tool you already have, execute that tool. Do not call 'searchTools'\
    \ again.\n- If you called a tool before do not call it again.\n4.\
    \ **Failure State**: If you cannot find a tool after one search, say\
    \ \"I am stuck\" and STOP.\n \n## Formatting\n- Direct Answer: Markdown\
    \ text.\n- Action: <tool_call><function=NAME><parameter=KEY>VALUE</parameter></function></tool_call>"
  family: LLM
  format: GGUF
  modules:
  - identifier: WGT
    mandatory: true
    module-type: WEIGHTS
    properties:
      quantization: IQ4-XS
    ready-files:
    - ax_qwen-3p5-text-only_bs_0p8b__LLM.WGT_IQ4-XS.gguf
    target-extension: gguf
  - identifier: TPT
    mandatory: true
    module-type: TEMPLATE
    ready-files:
    - ax_qwen-3p5-text-only_bs_0p8b__LLM.TPT.jinja
