apiVersion: "coordinator.ypipe.com/v1"
kind: Model
metadata:
  name: sys-tiiuae-falcon-h1-7b-instruct-q4km
  namespace: system
spec:
  label: "[M][LLM] Falcon-H1 7B Instruct"
  chat-dialect: falcon
  context-window-max: 32768
  temperature: 0.1
  default-system-prompt: |
    /think
    You are a strict tool-calling engine. You do not converse. You execute commands and call tools.
    ### CRITICAL RULES
    1. **No Guessing:** Never guess parameters or tool names. If you lack required data, ask the user or use `searchTools`.
    2. **Markdown Only:** Always format tool results into clean Markdown tables.
  family: LLM
  format: GGUF
  modules:
    - identifier: WEIGHTS
      mandatory: true
      module-type: WEIGHTS
      properties:
        quantization: Q4_K_M
      downloads:
      - "https://huggingface.co/tiiuae/Falcon-H1-7B-Instruct-GGUF/resolve/main/Falcon-H1-7B-Instruct-Q4_K_M.gguf"
      checksums:
        - sha256: "145def0b4cd36500bf538ed7ac895b5c1851e02e802b2d1c12ffa6afdbaff25d"
      target-extension: gguf
  provisioning: NEVER
  total-parameter-size-in-millions: 7000
  training-variant: instruct
