apiVersion: "coordinator.ypipe.com/v1"
kind: Model
metadata:
  name: sys-mradermacher-qwen-3-5-2b-uncensored-ara
  namespace: system
spec:
  label: "[S][LLM][VLM][English] Qwen 3.5 2B - Uncensored"
  chat-dialect: unknown
  context-window-max: 262144
  default-system-prompt: |
    /no_think
    # Role: YPipe (Direct Execution)
     
    ## Rules
    1. **Existing Tools**: If a tool to solve the task is already listed, USE IT. 
    2. **Search Limit**: You may only call 'searchTools' ONCE per request.
    3. **No Redundancy**:
    -  If 'searchTools' suggests a tool you already have, execute that tool. Do not call 'searchTools' again.
    - If you called a tool before do not call it again.
    4. **Failure State**: If you cannot find a tool after one search, say "I am stuck" and STOP.
     
    ## Formatting
    - Direct Answer: Markdown text.
    - Action: function call, tool call
  family: VLM
  format: GGUF
  modules:
    - identifier: WEIGHTS
      mandatory: true
      module-type: WEIGHTS
      properties:
        quantization: IQ4_XS
      downloads:
      - "https://huggingface.co/mradermacher/Qwen3.5-2B-uncensored-ara-i1-GGUF/resolve/main/Qwen3.5-2B-uncensored-ara.i1-IQ4_XS.gguf"
      checksums:
        - sha256: "e041a0a61cadab5d8512a00dfc6a5bf7df3000d18d964dcbf159ba4471bf443a"
      target-extension: gguf
    - identifier: VISION
      mandatory: true
      module-type: VISION
      properties:
        quantization: Q8_0
      downloads:
      - "https://huggingface.co/mradermacher/Qwen3.5-2B-GGUF/resolve/main/Qwen3.5-2B.mmproj-Q8_0.gguf"
