      target-extension: gguf
    - identifier: VISION
      mandatory: true
      module-type: VISION
      properties:
        quantization: Q8_0
      downloads:
      - "https://huggingface.co/mradermacher/gemma-4-31B-it-The-DECKARD-HERETIC-UNCENSORED-Thinking-GGUF/resolve/main/gemma-4-31B-it-The-DECKARD-HERETIC-UNCENSORED-Thinking.mmproj-Q8_0.gguf"
      checksums:
        - sha256: "a75726af77550e2edbb640c1413a8b63cb9c49c8c1bf35bcf9a8309850ff691f"
